# AWS
AWS_REGION=us-east-1
NODE_ENV=development

# Supabase (browser uses the anon key; Lambda digest uses the service role)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional shared Jev key. Each user normally saves their own key in Settings.
JEV_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/jev/v1/chat/completions

# Public API Gateway URL used by the dashboard Sync button
API_GATEWAY_ENDPOINT=
